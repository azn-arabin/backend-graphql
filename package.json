{
  "name": "backend-graphql",
  "version": "1.0.0",
  "description": "GraphQL API server for coding test",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "npm run build && node --test dist/tests/node-query.test.js",
    "generate:token": "npm run build && node dist/scripts/generate-token.js"
  },
  "keywords": [],
  "author": "Md. Asaduzzman Arabin",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "dotenv": "^17.2.2",
    "graphql": "^16.11.0",
    "graphql-scalars": "^1.24.2",
    "graphql-tag": "^2.12.6",
    "graphql-type-json": "^0.3.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
